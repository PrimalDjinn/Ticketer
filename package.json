{
  "name": "ticketer",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "build:node": "NITRO_PRESET=node-server nuxt build",
    "build:cloudflare": "NITRO_PRESET=cloudflare-durable nuxt build",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "db:generate": "nuxt db generate",
    "db:migrate": "nuxt db migrate",
    "db:studio": "drizzle-kit studio",
    "deploy": "pnpm build:cloudflare && wrangler deploy --config .output/server/wrangler.json",
    "cf:migrate": "wrangler d1 migrations apply DB --remote --config .output/server/wrangler.json"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.147",
    "@nuxt/ui": "^4.13.1",
    "@nuxthub/core": "^0.10.12",
    "@vueuse/core": "^14.4.0",
    "@vueuse/integrations": "^14.4.0",
    "consola": "^3.4.2",
    "drizzle-orm": "^0.45.4",
    "nuxt": "^4.6.4",
    "nuxt-auth-utils": "^0.6.2",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.5",
    "ulid": "^3.0.2",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "nodemailer": "^7.0.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261018.1",
    "@libsql/client": "^0.18.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "@types/sortablejs": "^1.15.9",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.166.0"
  }
}
