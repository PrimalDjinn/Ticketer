# --- Required everywhere ---------------------------------------------------------------------------------------------
# Seals session cookies. Generate with: openssl rand -base64 32
NUXT_APP_SECRET=

# --- First admin (optional) -----------------------------------------------------------------------------------------
# Created on first start when no account has this email; an existing account is never changed. Without these, the
# first person to register becomes admin. Or run `pnpm admin --email …` (Docker: exec ticketer node scripts/admin.mjs).
NUXT_ADMIN_EMAIL=
NUXT_ADMIN_PASSWORD=
# NUXT_ADMIN_NAME=admin

# --- Mail (password reset) -------------------------------------------------------------------------------------------
# Sender address. Unset = reset links are printed to the server log instead of mailed.
NUXT_MAIL_FROM=
# Node/Docker only: SMTP connection URL, e.g. smtps://user:app-password@smtp.gmail.com:465
NUXT_MAIL_SMTP_URL=

# --- Single sign-on (OpenID Connect, optional) ---------------------------------------------------------------------
# Or configure it in Settings → Sign-in; anything set here wins and is read-only there. Redirect URI to register at the
# provider: https://<your site>/auth/oidc/callback
# NUXT_OIDC_ISSUER=https://auth.example.com/application/o/ticketer/
# NUXT_OIDC_CLIENT_ID=
# NUXT_OIDC_CLIENT_SECRET=
# NUXT_OIDC_ENABLED=true                    # implied when issuer and client id are set here
# NUXT_OIDC_NAME=Authentik                  # "Continue with …" (default: Single sign-on)
# NUXT_OIDC_SCOPES=openid email profile
# NUXT_OIDC_DEFAULT_ROLE=external           # role for new people: external, viewer, member, or none (invite/groups only)
# NUXT_OIDC_GROUPS_CLAIM=groups
# NUXT_OIDC_ROLE_GROUPS=admin:ticketer-admins,member:staff,viewer:auditors,external:customers
# NUXT_OIDC_ONLY=false                      # true: no password sign-in (except admins), sign-up or reset
# NUXT_OIDC_REDIRECT_URL=                   # only if a proxy hides the public origin

# --- Node / Docker ---------------------------------------------------------------------------------------------------
# SQLite file (libsql). Dev uses .data/db/sqlite.db; the Docker image uses file:/app/.data/db/sqlite.db on its volume.
# (DATABASE_URL is deliberately not used, so a postgres:// URL from another project cannot break the app.)
# LIBSQL_URL=file:.data/db/sqlite.db
# TICKETER_IMAGE=ghcr.io/primaldjinn/ticketer:latest   # default; or a fork's image / a :sha-xxxxxxx tag
# TICKETER_PORT=3000
# CLOUDFLARE_TUNNEL_TOKEN=

# --- Cloudflare build (pnpm build:cloudflare, then wrangler deploy) -------------------------------------------------------
# Resources are declared in wrangler.jsonc. Left unset, the first `wrangler deploy` creates the D1 database and R2
# bucket for you; set these to use existing ones (e.g. from `wrangler d1 create ticketer`).
# CF_WORKER_NAME=ticketer
# CF_D1_DATABASE_ID=
# CF_R2_BUCKET=ticketer-files
# CF_CUSTOM_DOMAIN=tickets.example.com   # optional; the zone must be on the same Cloudflare account
# CF_SEND_EMAIL=true                     # add the EMAIL binding once the domain is onboarded to Email Sending
