# --- Required everywhere ---------------------------------------------------------------------------------------------
# Seals session cookies. Generate with: openssl rand -base64 32
NUXT_APP_SECRET=

# --- Mail (password reset) -------------------------------------------------------------------------------------------
# Sender address. Unset = reset links are printed to the server log instead of mailed.
NUXT_MAIL_FROM=
# Node/Docker only: SMTP connection URL, e.g. smtps://user:app-password@smtp.gmail.com:465
NUXT_MAIL_SMTP_URL=

# --- Node / Docker ---------------------------------------------------------------------------------------------------
# SQLite file (libsql). Dev uses .data/db/sqlite.db; the Docker image uses file:/app/.data/db/sqlite.db on its volume.
# (DATABASE_URL is deliberately not used, so a postgres:// URL from another project cannot break the app.)
# LIBSQL_URL=file:.data/db/sqlite.db
# TICKETER_IMAGE=ghcr.io/primaldjinn/ticketer:latest   # default; or a fork's image / a :sha-xxxxxxx tag
# TICKETER_PORT=3000
# CLOUDFLARE_TUNNEL_TOKEN=

# --- Cloudflare build (pnpm build:cloudflare / pnpm deploy) ------------------------------------------------------------
# Created with: wrangler d1 create ticketer && wrangler r2 bucket create ticketer-files
# CF_WORKER_NAME=ticketer
# CF_D1_DATABASE_ID=
# CF_R2_BUCKET=ticketer-files
